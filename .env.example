# Copy to .env (never commit .env) and insert the secrets LOCALLY.
GEMINI_API_KEY=REPLACE_LOCALLY_WITH_YOUR_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
# Server-side only: never paste secrets into chat or commit .env.
# v2: use the STAGING project only; never the production project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=REPLACE_LOCALLY_WITH_SUPABASE_SECRET

# Set a NEW strong staging-only Admin Console password in your local .env.
ADMIN_PASSWORD=REPLACE_LOCALLY_WITH_STRONG_STAGING_ADMIN_PASSWORD

# ---- v2 API server (React + FastAPI) ----
# Random 32+ character string; signs admin session cookies (rotating it signs everyone out).
SESSION_SECRET=REPLACE_LOCALLY_WITH_RANDOM_SESSION_SECRET
# Keep 1 in production (HTTPS). Set 0 only for plain-http local development.
COOKIE_SECURE=1
# Set 1 only behind a single trusted reverse proxy, so throttling uses the client IP.
TRUST_PROXY=0
# Local tests ONLY: in-memory database + test extractor. Refuses to start if SUPABASE_URL is set.
# VENDORFLOW_OFFLINE_MODE=1
